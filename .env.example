# ============================================================
# Lighthouse v1 — environment variables
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# Database (defaults to sqlite:///lighthouse.db if unset)
DATABASE_URL=sqlite:///lighthouse.db

# Anthropic
ANTHROPIC_API_KEY=

# ---- Crawler credentials (Task B) --------------------------

# Reddit (register at reddit.com/prefs/apps — script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AXI-Lighthouse/1.0 by u/your_username

# Trustpilot public API (developers.trustpilot.com — free tier)
TRUSTPILOT_API_KEY=

# BabyPips Discourse API key (optional — increases rate limit)
BABYPIPS_API_KEY=
BABYPIPS_API_USERNAME=

# Residential proxy (Decodo / Smartproxy — required for FPA, ForexFactory, Myfxbook)
PROXY_SERVER=http://gate.decodo.com:7000
PROXY_USERNAME=
PROXY_PASSWORD=

# Apple App Store Connect API (for AppStoreCrawler)
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY_PATH=

# ---- Crawler credentials (Task A — social media) -----------

# X (Twitter) API v2
X_BEARER_TOKEN=

# Meta Graph API (Facebook / Instagram)
META_ACCESS_TOKEN=
META_PAGE_ID=

# TikTok Research API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=

# BrandWatch
BW_USERNAME=
BW_PASSWORD=
BW_PROJECT_ID=
BW_QUERY_ID=

# ---- Response & escalation (Timur) -------------------------

# Flask dashboard
SECRET_KEY=
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_URL=http://localhost:5000
SESSION_LIFETIME_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10

# Jira
JIRA_MODE=mock
JIRA_BASE_URL=https://axitrader.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=APM
JIRA_EPIC_KEY=APM-75
JIRA_COMMUNITY_MANAGER_ACCOUNT_ID=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_EMAIL=
ESCALATION_TELEGRAM_CHAT_ID=
ESCALATION_EMAIL=julie.sharova@axi.com
DIGEST_RECIPIENTS=julie.sharova@axi.com
SLA_HOURS=24
REMINDER_INTERVAL_HOURS=12
WATCH_SPIKE_COUNT=3
WATCH_SPIKE_MULTIPLIER=2
SUPPORT_URL=https://support.axi.com

# Monitoring
SENTRY_DSN=
